# ---- Core ----------------------------------------------------------------
# Public URL of the app. For local development use http://127.0.0.1:3000
# (ATProto OAuth treats 127.0.0.1 / localhost as a "loopback" client and no
# private key is needed).
APP_URL=https://imta.rsvp
APP_NAME=imta
NODE_ENV=production

DATABASE_URL=postgres://imta:imta@db:5432/imta

# 32 random bytes, base64. Used to encrypt calendar / video provider tokens at
# rest. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# ---- ATProto OAuth --------------------------------------------------------
# Generate with `pnpm keygen`. One or more private JWKs (ES256). Rotate by
# adding a new key and removing the old one later.
ATPROTO_PRIVATE_KEY_1=
ATPROTO_PRIVATE_KEY_2=
# Fallback handle resolver (only used when DNS resolution is unavailable).
ATPROTO_HANDLE_RESOLVER=https://bsky.social
# Where users without an account are sent to create one.
ATPROTO_SIGNUP_URL=https://eurosky.social

# ---- Email (required: confirmations, ICS invites, reminders) --------------
# Any SMTP provider. Prefer an EU-hosted one (e.g. Scaleway TEM, Mailgun EU).
SMTP_URL=smtp://user:password@smtp.example.eu:587
EMAIL_FROM="imta <no-reply@imta.rsvp>"

# ---- Calendar providers ---------------------------------------------------
# Google Cloud console -> OAuth client (Web). Redirect URI:
#   ${APP_URL}/api/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra app registration (multi-tenant + personal). Redirect URI:
#   ${APP_URL}/api/calendar/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---- Video ----------------------------------------------------------------
# Zoom OAuth app (user-managed). Redirect URI: ${APP_URL}/api/video/zoom/callback
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Jitsi is the fallback when nothing else is connected.
JITSI_BASE_URL=https://meet.jit.si

# ---- Operations -----------------------------------------------------------
# Shared secret so the web app can validate calendar webhook calls it set up.
WEBHOOK_SECRET=
LOG_LEVEL=info
